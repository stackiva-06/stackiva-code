<Window x:Class="PrinterShare.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:PrinterShare.Client.ViewModels"
        mc:Ignorable="d"
        Title="PrinterShare Client" Height="520" Width="860">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Shared printers" FontSize="28" FontWeight="SemiBold" />
        <ListView Grid.Row="1" Margin="0,20,0,20" ItemsSource="{Binding Printers}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding DisplayName}" Width="260" />
                    <GridViewColumn Header="Host" DisplayMemberBinding="{Binding HostName}" Width="180" />
                    <GridViewColumn Header="Model" DisplayMemberBinding="{Binding Model}" Width="220" />
                    <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="120" />
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding DiscoverCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal"><md:PackIcon Kind="LanConnect" Margin="0,0,6,0"/><TextBlock Text="Discover"/></StackPanel>
            </Button>
            <Button Command="{Binding InstallSelectedCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal"><md:PackIcon Kind="PrinterPlus" Margin="0,0,6,0"/><TextBlock Text="Install Driver"/></StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
